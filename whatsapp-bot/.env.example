# ===== WhatsApp Cloud API (Meta) =====
# Token permanente del System User (Meta Business). NO el token temporal de 24hs.
WHATSAPP_TOKEN=
# ID del numero de telefono (Phone Number ID) que da Meta en la consola.
WHATSAPP_PHONE_NUMBER_ID=
# Token que vos inventas para verificar el webhook (lo pones igual en la consola de Meta).
WHATSAPP_VERIFY_TOKEN=pare-carrito-webhook
# (Opcional) Secreto de la app para validar la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=

# ===== Notificaciones internas =====
# La Cloud API NO puede postear en grupos de WhatsApp. Avisos al "grupo" = a estos numeros
# (separados por coma, formato internacional sin +, ej: 5493874566725).
NOTIFY_NUMBERS=
# Tu numero personal para las consultas que no son pedidos.
OWNER_NUMBER=

# ===== IA (clasificacion de intencion) - reusa OpenRouter =====
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-4o-mini

# ===== ERP (servidor Pare Carrito) =====
# URL base del servidor del ERP (el mismo que usa la app).
ERP_BASE_URL=https://TU_DOMINIO_API
# Clave para los endpoints externos del ERP (EXTERNAL_API_KEY del .env del servidor).
ERP_API_KEY=

# ===== Reglas de horario (hora local del negocio) =====
TZ=America/Argentina/Salta
# Antes de esta hora, agregar va directo (sin avisar). HH:MM
ADD_DIRECT_BEFORE=05:30
# Ventana de confirmacion 1ra ronda.
ADD_CONFIRM1_UNTIL=07:30
# Ventana de confirmacion 2da ronda.
ADD_CONFIRM2_UNTIL=10:00

PORT=8090
