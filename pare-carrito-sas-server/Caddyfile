# Caddy sirve el frontend y la API con HTTPS automatico (Let's Encrypt).
# Los dominios se toman del archivo .env via docker-compose.
# El frontend habla con la API en /api del MISMO dominio: los dispositivos
# no necesitan configurar ninguna URL.

{$SITE_DOMAIN} {
	encode gzip

	handle_path /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/frontend
		# HTML/JS/CSS: revalidar SIEMPRE contra el servidor (ETag). Asi cada deploy se aplica al
		# recargar la pagina, sin necesidad de Ctrl+F5. Evita que los dispositivos queden con una
		# version vieja del frontend (que, por ejemplo, no sellaba updatedAt y perdia cambios).
		@revalidate {
			path / *.html *.js *.css
		}
		header @revalidate Cache-Control "no-cache, must-revalidate"
		file_server
	}
}

# Acceso directo a la API (opcional, util para integraciones externas)
{$API_DOMAIN} {
	# Webhook del bot de WhatsApp: Meta apunta a https://API_DOMAIN/wa/webhook
	# (handle_path saca el prefijo /wa, asi el bot recibe /webhook)
	handle_path /wa/* {
		reverse_proxy whatsapp-bot:8090
	}

	handle {
		reverse_proxy api:3000
	}
}
