# Copiar a .env y completar. NUNCA subir el .env a un repositorio.

# Contrasena de la base de datos (inventar una larga)
POSTGRES_PASSWORD=cambiar-por-una-clave-larga

# Secreto para firmar los JWT. Generar con:  openssl rand -hex 32
JWT_SECRET=cambiar-por-64-caracteres-hexadecimales

# Dominio del frontend (para CORS). Con Caddy en este compose: https://TU-DOMINIO
ALLOWED_ORIGIN=https://sistema.ejemplo.com

# Dominios que atiende Caddy (frontend y API). Deben apuntar al VPS (registro A).
SITE_DOMAIN=sistema.ejemplo.com
API_DOMAIN=api.ejemplo.com

# Usuario administrador inicial (solo se crea si la base esta vacia)
ADMIN_USERNAME=gerente
ADMIN_PASSWORD=gerente123

# --- Envio de correos (Brevo: smtp-relay.brevo.com) ---
# Crear cuenta gratis en https://www.brevo.com -> SMTP & API -> SMTP keys
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=el-login-smtp-de-brevo
SMTP_PASS=la-clave-smtp-de-brevo
MAIL_FROM=Pare Carrito SAS <operaciones@parecarrito.com>

# URL publica del sistema (para los links de los correos)
PUBLIC_URL=https://sistema.ejemplo.com

# --- Facturacion electronica AFIP via TusFacturasAPP (https://developers.tusfacturas.app) ---
# Obtener en tusfacturas.app: Mi cuenta -> API -> credenciales (apikey, apitoken, usertoken)
# Mientras esten vacias, la facturacion corre en modo SIMULACION (no emite nada real).
TUSFACTURAS_APIKEY=
TUSFACTURAS_APITOKEN=
TUSFACTURAS_USERTOKEN=
# Punto de venta dado de alta en TusFacturasAPP para tu CUIT
TUSFACTURAS_PUNTO_VENTA=1
# Provincia segun tabla de TusFacturas (17 = Salta; verificar en developers.tusfacturas.app/parametros)
TUSFACTURAS_PROVINCIA=17
TUSFACTURAS_RUBRO=Frutas y verduras

# --- API externa (lectura de saldos/cajas/proveedores/pagos + aprobar transferencias) ---
# Vacia = deshabilitada. Generar con: openssl rand -hex 24
EXTERNAL_API_KEY=

# --- OCR de imagenes (fotos de pedidos manuscritos) ---
# Se prueban en orden: NVIDIA -> OpenRouter -> Moonshot/Kimi. El primero que responda gana.
# NVIDIA Nemotron OCR v2 (recomendado): API key de https://build.nvidia.com (empieza con nvapi-).
NVIDIA_API_KEY=
# URL del endpoint OCR. Confirmar en build.nvidia.com (boton "Get API Key" -> ejemplo de codigo).
# Por defecto usa el endpoint hosteado; para NIM propio: http://TU_HOST:8000/v1/ocr
NVIDIA_OCR_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2
# Nivel de agrupado del texto: word | sentence | paragraph
NVIDIA_OCR_MERGE_LEVEL=paragraph
# Respaldo por chat-vision (opcional):
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
MOONSHOT_API_KEY=
MOONSHOT_VISION_MODEL=moonshot-v1-32k-vision-preview
